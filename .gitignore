# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Corpus working area (pointer-based records are tracked; fetched sources are not)
corpus/_fetched/
corpus/_build/

# Run artifacts
runs/
*.jsonl

# Editor / OS
.DS_Store
.idea/
.vscode/

# A fetched source checkout. 134 files, reproducible from the pins.
# Anchored: an unanchored `checkout/` also ignored `tests/checkout/`, which is
# how the module that pins the published figures went missing from its own
# commit.
/checkout/

# Tool caches. Anchored, for the reason `/checkout/` is: an unanchored rule
# here would also ignore a directory of the same name under `tests/`.
# The measurements in `docs/measurements/` are tracked; the thousands of cached
# HTTP and JSON-RPC responses they were computed from are not.
/.harvest-cache/
/.c4-cache/
/.incident-cache/
/.proxy-cache/
